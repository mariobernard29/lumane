NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9OsPjs6xOk37ZNR4aKaHwQ_gVlWiG9f

# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_: expondría la base entera.
# Se obtiene en Supabase → Project Settings → API → service_role.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# El secreto del webhook NO es una llave de la cuenta: lo genera cada endpoint.
#   * En local:      npx stripe listen --forward-to localhost:3100/api/webhooks/stripe
#     (imprime un whsec_... temporal, válido mientras el comando siga corriendo)
#   * En producción: Stripe → Developers → Webhooks → añade el endpoint
#     https://TU-DOMINIO/api/webhooks/stripe con los eventos
#     payment_intent.succeeded, payment_intent.processing,
#     payment_intent.payment_failed y payment_intent.canceled
#
# Sin este valor el webhook responde 500 y NO procesa nada: es deliberado,
# porque sin firma no hay forma de distinguir un aviso real de uno inventado.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google Maps — DOS llaves distintas a propósito:
#   * la del navegador va restringida por dominio (Places Autocomplete)
#   * la del servidor nunca sale de la Edge Function (Distance Matrix)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ---------------------------------------------------------------------------
# Resend
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="LUMANE <contacto@lumane.mx>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
