# ---------------------------------------------------------------------------
# Lumane POS — variables de la tablet
# ---------------------------------------------------------------------------
# `EXPO_PUBLIC_` significa que el valor viaja DENTRO del APK y cualquiera que
# lo descompile lo puede leer. Aquí solo pueden ir llaves públicas.
#
# La llave `service_role` NO existe en este archivo ni en ninguno de esta
# carpeta. El POS entra por RLS y por RPC, igual que la tienda en línea: es lo
# que hace que una tablet perdida o robada no sea una base de datos abierta.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://izyoixhffjjodzizkbqk.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
