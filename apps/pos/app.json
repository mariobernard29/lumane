{
  "expo": {
    "name": "Lumane POS",
    "slug": "lumane-pos",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "lumanepos",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "mx.lumane.pos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/monograma-tinta.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Lumane usa la cámara para leer el código de barras de las prendas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumane usa tus fotos para agregarlas a las prendas del catálogo.",
          "cameraPermission": "Lumane usa la cámara para fotografiar las prendas del catálogo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/monograma-hueso.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "222c1a7f-a731-4e81-8925-9c7812878ab8"
      },
      "router": {}
    },
    "owner": "mbernard29",
    "updates": {
      "url": "https://u.expo.dev/222c1a7f-a731-4e81-8925-9c7812878ab8"
    },
    "ios": {},
    "icon": "./assets/icono.png"
  }
}
